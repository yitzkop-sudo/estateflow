# ── Copy this file to functions/.env and fill in your own values ─────────────
# Deployed/picked up automatically by Firebase Functions (v2 runtime):
#   cp functions/.env.example functions/.env

# Stripe API keys from https://dashboard.stripe.com/apikeys
# Test mode: sk_test_...   Live mode: sk_live_...
STRIPE_SECRET_KEY=sk_test_PASTE_SECRET_KEY

# Signing secret of the "rent payments" webhook endpoint
# (Dashboard → Developers → Webhooks, or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_PASTE_SIGNING_SECRET

# Public HTTPS URL where the tenant portal (web/ folder) is hosted.
# Used for Stripe Checkout redirects and Connect onboarding redirects.
WEB_BASE_URL=https://estateflow-827fc.web.app

# Optional platform fee taken from each rent payment (percent, e.g. 2.5).
# Set to 0 for no fee — landlord receives the full rent amount.
PLATFORM_FEE_PERCENT=0

# ── Paid "utility auto-sync" subscription (auto pull utility bills) ────────────
# Your UtilityAPI secret token (https://utilityapi.com). Kept server-side so the
# mobile app never sees it. Only active subscribers can use it.
UTILITYAPI_TOKEN=PASTE_UTILITYAPI_TOKEN

# A monthly Stripe recurring Price ID for the auto-sync plan (e.g. price_1...).
# Create it in Stripe Dashboard → Products → Recurring, then paste the ID here.
UTILITY_PLAN_PRICE_ID=price_xxxxxxxxxxxxxxxxx

# Maximum meters a subscriber can auto-link with the flat monthly plan.
# This caps your real UtilityAPI cost: you pay ~$3/meter/month to keep a meter
# refreshed + ~$12 one-time backfill, so keep this well below the subscription
# price divided by ~$3 to stay profitable (e.g. price $29/mo → limit 5–9 meters).
# Defaults to 10 if unset.
UTILITY_AUTO_METER_LIMIT=10
