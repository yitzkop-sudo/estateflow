#  EstateFlow â€” Netlify environment variables (TEMPLATE)
#
#  How to use:
#    1. Fill in every value below (raw values â€” no quotes, no spaces
#       around "=").
#    2. Netlify Dashboard â†’ your API site â†’ Site configuration â†’
#       Environment variables â†’ "Import from a .env file" â†’ paste
#       this file's contents.
#       â€¦or with the Netlify CLI:   netlify env:import .env.netlify.example
#    3. Redeploy (Deploys â†’ Trigger deploy â†’ Deploy site) so they go live.
#
#  Real secrets must never be committed â€” this example file is the only
#  env file that belongs in git.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Firebase Admin (NETLIFY_SETUP.md â†’ Step 1) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Firebase Console â†’ âš™ Project settings â†’ Service accounts â†’
# "Generate new private key" â†’ open the JSON and paste the ENTIRE thing
# here on ONE single line (no line breaks).
FIREBASE_SERVICE_ACCOUNT=PASTE_ENTIRE_SERVICE_ACCOUNT_JSON_ON_ONE_LINE

# â”€â”€ Stripe (Dashboard â†’ Developers â†’ API keys) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use sk_test_... while testing, sk_live_... for real money.
STRIPE_SECRET_KEY=sk_test_PASTE_SECRET_KEY
# Developers â†’ Webhooks â†’ Add endpoint:
#   https://shiny-lokum-eb48e1.netlify.app/.netlify/functions/api/stripe-webhook
# Events: checkout.session.completed, account.updated, invoice.paid,
#         customer.subscription.updated, customer.subscription.deleted
# Then copy the signing secret here:
STRIPE_WEBHOOK_SECRET=whsec_PASTE_SIGNING_SECRET

# â”€â”€ Stripe plan prices (Products â†’ click each price â†’ copy price_ ID) â”€â”€
STARTER_PLAN_PRICE_ID=price_1UC0sJ7a3d2oTFVPSfdFRNbK
PROFESSIONAL_PLAN_PRICE_ID=price_1UC10L7a3d2oTFVP5GEXKV8q
# In-app utility checkout is meter-only (no base plan). This var is only kept
# for the marketing-site plan mapping â€” the app bills UTILITY_METER_PRICE_ID.
UTILITY_PLAN_PRICE_ID=price_1UC1AT7a3d2oTFVPPKH3PMPD
# The $20/meter usage-based price ("Extra utility meter") â€” REQUIRED for checkout
UTILITY_METER_PRICE_ID=price_1UC1Vj7a3d2oTFVP8oxidDP1
# NOTE: this must be a FLAT recurring $20/mo price (standard pricing, NOT
# metered/usage-based). Checkout bills quantity x $20 upfront; the API keeps
# quantity equal to linked meters.
# Legacy: only used by old metered-price subscriptions, ignored for flat prices
UTILITY_METER_EVENT_NAME=Extra utility meter
# Max linked meters when NO metered price is set (999 when metering is on)
UTILITY_AUTO_METER_LIMIT=999

# â”€â”€ UtilityAPI (utilityapi.com â†’ account â†’ API token) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
UTILITYAPI_TOKEN=PASTE_UTILITYAPI_TOKEN

# â”€â”€ URLs & misc â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public URL that serves web/ (landing page + tenant portal), no trailing
# slash. If web/ is hosted on this same Netlify site, use:
#   https://shiny-lokum-eb48e1.netlify.app
WEB_BASE_URL=PASTE_WEB_BASE_URL
# Share of each rent payment kept by the platform (0 = landlord keeps all)
PLATFORM_FEE_PERCENT=0

# â”€â”€ Expo app only (root .env â€” NOT needed on Netlify) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# EXPO_PUBLIC_API_URL=https://shiny-lokum-eb48e1.netlify.app/.netlify/functions/api
